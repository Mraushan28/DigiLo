# Environment Variables Template
# Copy this file to .env.local and fill in your details

# App Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Resend API key for sending emails (Create one at https://resend.com)
RESEND_API_KEY="your_resend_api_key_here"

# Email address where you want to receive the contact form submissions
CONTACT_EMAIL="digilotech@gmail.com"

# Public variables for the frontend
NEXT_PUBLIC_WHATSAPP_NUMBER="7707052307"
NEXT_PUBLIC_NEXTODYSSEY_CONTRACT_URL="https://nextodyssey.space/"

# AI Engine (NVIDIA or OpenAI API)
NVIDIA_API_KEY="your_nvidia_api_key_here"
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"
NVIDIA_MODEL="openai/gpt-oss-20b"
# OPENAI_API_KEY="your_openai_api_key_here"

# -------------------------------------------------------------
# DIGILO INTEGRATION CONNECTION SYSTEM (OAuth 2.0 & Token Vault)
# -------------------------------------------------------------

# Secret key used for AES-256-GCM encryption of client OAuth tokens at rest
# Generate a random 32-byte hex key: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY="replace_with_64_character_hex_encryption_key"

# Google Sheets OAuth 2.0 (Google Cloud Console > APIs & Services > Credentials)
# Authorized redirect URI to register in Google Console:
# http://localhost:3000/api/automation/integrations/google/callback
# (and https://yourdomain.com/api/automation/integrations/google/callback for production)
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/automation/integrations/google/callback"

# Slack OAuth 2.0 (Slack API > Your Apps > OAuth & Permissions)
# Authorized redirect URL to register in Slack App settings:
# http://localhost:3000/api/automation/integrations/slack/callback
# (and https://yourdomain.com/api/automation/integrations/slack/callback for production)
# Required Bot Token Scopes: chat:write, chat:write.public, channels:read, groups:read, team:read
SLACK_CLIENT_ID="your_slack_client_id"
SLACK_CLIENT_SECRET="your_slack_client_secret"
SLACK_REDIRECT_URI="http://localhost:3000/api/automation/integrations/slack/callback"

# -------------------------------------------------------------
# MONGODB PERSISTENCE & MULTI-TENANT AUTHENTICATION
# -------------------------------------------------------------
# MongoDB connection string (Atlas cluster or local URI)
# Defaults to in-memory fallback during local development/offline testing if omitted
MONGODB_URI="mongodb://localhost:27017/digilo"

# Secret key used for signing session tokens (HMAC-SHA256)
AUTH_SECRET="replace_with_secure_random_session_secret"

